                  ]
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "button",
                      "select-session",
                      "display"
                    ]
                  }
                },
                "supported": {
                  "type": "boolean"
                },
                "verifiedIdentity": {
                  "type": "string"
                }
              },
              "required": [
                "candidateId",
                "source",
                "generation",
                "nativeDeviceId",
                "label",
                "transport",
                "capabilities",
                "supported"
              ],
              "additionalProperties": false
            }
          },
          "deviceSources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "scanning",
                    "ready",
                    "failed",
                    "missing_plugin"
                  ]
                }
              },
              "required": [
                "source",
