                }
              },
              "required": [
                "deviceId",
                "controllerId",
                "source",
                "label",
                "transport",
                "capabilities",
                "revision",
                "state",
                "selection"
              ],
              "additionalProperties": false
            }
          },
          "deviceCandidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidateId": {
                  "type": "string"
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "pluginId": {
                      "type": "string"
                    },
                    "instanceId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "pluginId",
