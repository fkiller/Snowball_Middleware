                "status"
              ],
              "additionalProperties": false
            }
          },
          "workspaceDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceSummary"
            }
          }
        },
        "required": [
          "cursor",
          "sessions",
          "commands",
          "decisions",
          "workspaces",
          "devices",
          "deviceCandidates",
          "deviceSources",
          "workspaceDetails"
        ],
        "additionalProperties": false
      },
      "WorkspaceSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspaceId",
          "projectId",
          "displayName",
          "status"
        ],
        "properties": {
          "workspaceId": {
            "type": "string",
            "pattern": "^ws_[a-f0-9]{16}$"
          },
          "projectId": {
            "type": "string",
            "pattern": "^prj_[a-f0-9]{16}$"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "empty",
              "missing",
              "needs_permission",
              "needs_review",
              "unavailable"
            ]
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Generic error code; no raw exception/path/credential. Authentication 401, origin/CSRF 403, stale intent 409, capacity 429, unavailable 503.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
