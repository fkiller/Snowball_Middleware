{
  "name": "snowball-middleware",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start:local": "node apps/supervisor/run.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "test:reference": "node scripts/test-reference.mjs",
    "test:reference:speech": "node scripts/test-reference.mjs --speech",
    "plan": "node docs/middleware/validate-plan.mjs --next",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:plugin-reference": "node --test examples/standalone-device-plugin/test.mjs",
    "install:desktop": "node node_modules/electron/install.js",
    "start:tray": "node apps/desktop/launch.mjs",
    "test:tray": "node apps/desktop/launch.mjs --smoke-test",
    "export:harnesses": "node scripts/export-harness-repositories.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:windows-installer": "node scripts/package-windows-installer.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "20.19.43",
    "electron": "44.4.3",
    "typescript": "5.9.3"
  }
}
